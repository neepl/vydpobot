# Copy to .env and fill in. Never commit .env.

# --- Telegram ---
# Bot token from @BotFather.
TELEGRAM_TOKEN=123456:ABC-your-token
# Chat that receives alerts: your user id, or a group id (negative, e.g. -1001234567890).
ALERT_CHAT_ID=0
# Comma-separated Telegram user ids allowed to use admin commands (/threshold, /lang set).
ADMIN_USER_IDS=
# Comma-separated extra chat ids allowed to use read-only commands.
# Empty = only ALERT_CHAT_ID and private chats of admins.
ALLOWED_CHAT_IDS=

# --- Solarman backend ---
# openapi (default, official; needs the OpenAPI block below) or portal (temporary, unofficial
# web-portal API; needs the portal block below). See README "Temporary: web-portal backend".
SOLARMAN_BACKEND=openapi

# --- Solarman Cloud OpenAPI (required when SOLARMAN_BACKEND=openapi) ---
SOLARMAN_BASE_URL=https://globalapi.solarmanpv.com
SOLARMAN_APP_ID=
SOLARMAN_APP_SECRET=
# Solarman account login. Set EITHER the plain password (hashed by the bot before sending)
# OR its lowercase hex SHA-256, so the plain password is never stored. Not both.
SOLARMAN_EMAIL=
SOLARMAN_PASSWORD=
# SOLARMAN_PASSWORD_SHA256=
# Optional: leave empty to use the first station on the account.
# SOLARMAN_STATION_ID=
# Optional: serial number of the MASTER inverter (with parallel inverters). Used ONLY for grid
# status (grid voltage/frequency -> outage detection); never for plant totals. OpenAPI only
# (ignored by the portal backend). Costs one API call per DEVICE_POLL_S.
# SOLARMAN_DEVICE_SN=
# Seconds between device (grid status) calls; minimum 300. 600 = 144 calls/day.
# DEVICE_POLL_S=600
# Solarman OpenAPI calls allowed per day (free tier ~548). Admins are told at 90%; at 100% the
# bot skips device polls and /graph history fetches (realtime polling always continues).
# SOLARMAN_DAILY_BUDGET=548
# Flip signs if `vydpobot dump` shows them reversed (battery_w > 0 must mean charging,
# grid_w > 0 must mean importing from the grid).
SOLARMAN_INVERT_BATTERY_SIGN=false
SOLARMAN_INVERT_GRID_SIGN=false

# --- Solarman web portal (required when SOLARMAN_BACKEND=portal; use a TEST account) ---
# `refresh_token` from the JSON response of the oauth2-s/oauth/token request seen in browser DevTools
# (Network, Preserve log) when logging in at home.solarmanpv.com with the test account. NOT the
# 24 h access_token. (Some regions also have a refresh-token cookie 442287045fabeaa868450dec4baee7f4.)
# Only the starting value: the bot stores the rotated token in its database. Change it here to
# force a new token, or send /token <value> to the bot in a private chat.
# SOLARMAN_PORTAL_REFRESH_TOKEN=
# Optional region code sent when renewing the token (omitted when unset).
# SOLARMAN_PORTAL_AREA=
# Some regions use https://globalhome.solarmanpv.com
# SOLARMAN_PORTAL_BASE_URL=https://home.solarmanpv.com

# --- Monitoring ---
# Poll interval in seconds (minimum 120; the logger uploads about every 5 minutes).
POLL_INTERVAL_S=300
# Alert when battery SOC falls to this percentage (5..100). Runtime override: /threshold.
ALERT_THRESHOLD_PCT=50
# Repeat the alert at every further step below the threshold (50, 45, 40, ...).
ALERT_STEP_PCT=5
# min 2; SOC must rise this far above the threshold before the alert cycle resets
REARM_HYSTERESIS_PCT=5
# Warn when the logger has not reported for this many minutes (0 disables).
STALE_AFTER_MIN=30

# --- Battery runtime during grid outages ---
# SOC (%) at which the inverter cuts the home supply (0..50). Not readable via the cloud, so set
# it to match the inverter's settings.
BATTERY_SHUTDOWN_SOC=10
# Usable battery capacity in kWh. Leave unset to learn it from charge/discharge history.
# BATTERY_CAPACITY_KWH=69
# Averaging window for the discharge power used in the estimate, minutes (15..360).
RUNTIME_WINDOW_MIN=120

# --- Building equipment (healthchecks.io), optional ---
# Read-only API key: Project Settings -> API Access -> "Create API keys" -> read-only.
# HEALTHCHECKS_API_KEY=
# Checks to watch, comma-separated; match by slug, name, unique key or UUID (any letter case).
# Both the key and the list are required, otherwise monitoring stays off (a warning is logged).
# HEALTHCHECKS_CHECKS=internet, cameras, lift
# How often to poll the API, seconds (minimum 60).
# HEALTHCHECKS_POLL_S=300
# Only for a self-hosted healthchecks instance.
# HEALTHCHECKS_API_URL=https://healthchecks.io

# --- General ---
# Default language: en or uk. Runtime override: /lang.
LANGUAGE=en
# IANA timezone for displayed times and chart axes.
TIMEZONE=Europe/Kyiv
# SQLite database path (compose.yaml sets this to /app/data/vydpobot.sqlite3).
DB_PATH=data/vydpobot.sqlite3
